# CourierLedger M1 — environment template.
# Copy to .env (at m1/ root for docker compose, or backend/.env for local runs)
# and replace EVERY CHANGE_ME value with a real secret. Never commit a
# filled-in .env. No real secrets are in this file.

# PostgreSQL (target database). The APPLICATION connects as the RUNTIME
# role (courierledger_runtime) -- never as the owner role (B-4 fix).
# Default points at the docker-compose db service.
DATABASE_URL=postgresql+psycopg://courierledger_runtime:CHANGE_ME@127.0.0.1:5432/courierledger

# Alembic migrations + admin SQL connect as the OWNER role
# (courierledger). The app never uses this URL. Alembic reads it from
# MIGRATION_DATABASE_URL first, then DATABASE_URL (see backend/alembic/env.py).
MIGRATION_DATABASE_URL=postgresql+psycopg://courierledger:CHANGE_ME@127.0.0.1:5432/courierledger

# Long random secrets — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_A_LONG_RANDOM_SECRET

# docker-compose db service credentials (must match DATABASE_URL).
POSTGRES_USER=courierledger
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=courierledger

# Vite dev server origin (CORS allow-list, single origin).
FRONTEND_URL=http://127.0.0.1:5173

# App environment: development | test | production
ENVIRONMENT=development

# Dev/test convenience ONLY: create auth tables at startup when true.
# Default false; production schema is owned by Alembic migrations.
CREATE_TABLES_ON_STARTUP=false

# Set SESSION_COOKIE_SECURE=true when serving behind HTTPS.
SESSION_COOKIE_SECURE=false
