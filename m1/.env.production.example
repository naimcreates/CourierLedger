# CourierLedger M1 — PRODUCTION environment template (Phase 3, Stream C).
# Copy to .env.production (next to docker-compose.production.yml) and
# fill EVERY value from the production secret store. Never commit a
# filled-in .env.production. No real secrets are in this file — every
# value below is a placeholder that the app or compose will reject.
#
# How the values reach the app: `docker compose -f
# docker-compose.production.yml --env-file .env.production ...` puts
# them in the container's process environment. (A value may also come
# from a .env file — the startup validator is value-based, not
# source-based; see backend/app/config.py: validate_production_settings.)
#
# The production host does not exist yet. Do not invent one: the
# host, the reverse proxy product, and the secret store are all
# founder decisions (see PRODUCTION_CONFIGURATION_GUIDE.md §10).

# --- PostgreSQL (db service) ---
# The APPLICATION connects as the RUNTIME role (courierledger_runtime)
# — never as the owner role (B-4 fix). The owner role (courierledger)
# is for Alembic migrations and admin SQL only.
POSTGRES_USER=courierledger
POSTGRES_PASSWORD=CHANGE_ME_REPLACE_WITH_A_LONG_RANDOM_SECRET
POSTGRES_DB=courierledger

# Runtime-role URL (backend). Password = the runtime role's password
# from the secret store. Host `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://courierledger_runtime:CHANGE_ME_RUNTIME_PASSWORD@db:5432/courierledger

# Owner-role URL (migrate service only — Alembic). The app never uses
# this URL. Password = the owner role's password from the secret store.
MIGRATION_DATABASE_URL=postgresql+psycopg://courierledger:CHANGE_ME_OWNER_PASSWORD@db:5432/courierledger

# --- Application secrets ---
# Long random values — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never the local-dev values, never committed.
SECRET_KEY=CHANGE_ME_REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Frontend / CORS ---
# Single allowed origin, https:// and no trailing slash. This is the
# origin the production frontend is served from (static host or
# reverse proxy — founder decision, not chosen yet).
FRONTEND_URL=https://CHANGE_ME_YOUR_DOMAIN

# --- Reverse proxy ---
# Address(es) of the TLS-terminating reverse proxy, as seen from the
# backend container (e.g. the proxy container's IP on the compose
# network, or its service name if the proxy runs on this network).
# uvicorn trusts X-Forwarded-For / X-Forwarded-Proto ONLY from these
# IPs. A wrong value here means the rate limiter keys on the proxy's
# IP for every client — set it from the real proxy, never "*".
TRUSTED_PROXY_IPS=CHANGE_ME_PROXY_ADDRESS

# --- Fixed production values (do not change) ---
ENVIRONMENT=production
SESSION_COOKIE_SECURE=true
CREATE_TABLES_ON_STARTUP=false
